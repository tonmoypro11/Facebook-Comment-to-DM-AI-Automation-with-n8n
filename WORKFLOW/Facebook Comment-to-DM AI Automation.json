        "mode": "runOnceForEachItem",
        "jsCode": "// Pull post/comment/user details out of the Facebook feed event\nconst value = $json.body.entry[0].changes[0].value;\n\nreturn {\n  postId: value.post_id,\n  commentId: value.comment_id,\n  userId: value.from ? value.from.id : null,\n  userName: value.from ? value.from.name : null,\n  userComment: value.message || '',\n};"
